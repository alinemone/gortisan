package config

import "time"

// Postgres is the database connection. Add `Postgres Postgres` to Config and
// `Postgres: r.postgres(),` to Load.
type Postgres struct {
	Host           string
	Port           uint16
	Database       string
	User           string
	Password       string
	Schema         string // search_path when set
	SSLMode        string // disable, prefer, require, verify-full ...
	MaxConns       int32
	MinConns       int32
	ConnectTimeout time.Duration
}

func (r *reader) postgres() Postgres {
	return Postgres{
		Host:           r.str("POSTGRES_HOST", "localhost"),
		Port:           uint16(r.integer("POSTGRES_PORT", 5432)),
		Database:       r.str("POSTGRES_DATABASE", "{{.Name}}"),
		User:           r.str("POSTGRES_USER", "postgres"),
		Password:       r.str("POSTGRES_PASSWORD", ""),
		Schema:         r.str("POSTGRES_SCHEMA", ""),
		SSLMode:        r.str("POSTGRES_SSLMODE", "prefer"),
		MaxConns:       int32(r.integer("POSTGRES_MAX_CONNS", 10)),
		MinConns:       int32(r.integer("POSTGRES_MIN_CONNS", 2)),
		ConnectTimeout: r.duration("POSTGRES_CONNECT_TIMEOUT", 5*time.Second),
	}
}
