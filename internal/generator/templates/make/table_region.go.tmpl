package {{.Pkg}}

import (
	"{{.Module}}/internal/platform/database/orm"
)

// gortisan:table {{.Type}} begin — generated from {{.File}} by gortisan generate; edits here are overwritten.

// {{.Var}}Table maps {{.Type}} to the {{.Table}} table: every field with a db
// tag is a column; pk and default columns are not inserted.
var {{.Var}}Table = orm.Table[{{.Type}}]{
	Name:       "{{.Table}}",
	PrimaryKey: "{{.PK}}",
	Columns: []string{
{{- range .Columns}}
		"{{.Column}}",
{{- end}}
	},
	Scan: func(row orm.Scanner, m *{{.Type}}) error {
		return row.Scan(
{{- range .Columns}}
			&m.{{.Field}},
{{- end}}
		)
	},
	InsertColumns: []string{
{{- range .Insert}}
		"{{.Column}}",
{{- end}}
	},
	InsertValues: func(m *{{.Type}}) []any {
		return []any{
{{- range .Insert}}
			m.{{.Field}},
{{- end}}
		}
	},
{{- if .UpdatedAt}}
	UpdatedAtColumn: "{{.UpdatedAt}}",
{{- end}}
{{- if .SoftDelete}}
	SoftDeleteColumn: "{{.SoftDelete}}",
{{- end}}
}

// gortisan:table {{.Type}} end
