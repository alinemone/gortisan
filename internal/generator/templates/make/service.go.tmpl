package {{.Pkg}}

// Service holds the {{.Pkg}} business logic. Its dependencies are passed to
// NewService in main.go. Methods take a context first and return plain
// errors; the handler decides which HTTP status an error becomes.
type Service struct {
{{- if .HasRepository}}
	repo *Repository
{{- end}}
}

func NewService({{if .HasRepository}}repo *Repository{{end}}) *Service {
	return &Service{ {{- if .HasRepository}}repo: repo{{end -}} }
}
