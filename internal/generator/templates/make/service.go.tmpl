package {{.Pkg}}
{{- if .HasStore}}

import "context"
{{- end}}

// Service holds the {{.Words}} business rules. It is the one entry point the
// API, the workers and other domains use. Methods take a context first and
// return plain errors (see errors.go); the caller decides what an error
// means to its client.
type Service struct {
{{- if .HasStore}}
	store Store
{{- end}}
}

func NewService({{if .HasStore}}store Store{{end}}) *Service {
	return &Service{ {{- if .HasStore}}store: store{{end -}} }
}
{{- if .HasStore}}

// Find returns ErrNotFound when there is no such {{.Words}}.
func (s *Service) Find(ctx context.Context, id int64) (*{{.Type}}, error) {
	return s.store.Find(ctx, id)
}
{{- end}}
