// Package cdc publishes change-data-capture events of models to Kafka:
//
//	{"reference_id": 7, "log_time": "2026-11-16 10:00:00.000000+03:30", "operation": "U",
//	 "old_data": {...}, "new_data": {...}, "change_data": ["status"]}
//
// Publish after the transaction commits, so consumers never see a change
// that was rolled back.
package cdc

import (
	"context"
	"encoding/json"
	"fmt"
	"slices"
	"strconv"
	"time"

	kafkago "github.com/segmentio/kafka-go"
)

// The operations of an Event.
const (
	Insert = "I"
	Update = "U"
	Delete = "D"
)

const logTimeLayout = "2006-01-02 15:04:05.000000-07:00"

// Event is one published change.
type Event struct {
	ReferenceID int64          `json:"reference_id"`
	LogTime     string         `json:"log_time"`
	Operation   string         `json:"operation"`
	OldData     map[string]any `json:"old_data"`
	NewData     map[string]any `json:"new_data"`
	ChangeData  []string       `json:"change_data"`
}

// publish sends one event keyed by id. before and after are what consumers
// see of the row (nil before an insert and after a delete).
func publish(ctx context.Context, w *kafkago.Writer, topic string, id int64, operation string, before, after any) error {
	event := Event{ReferenceID: id, LogTime: time.Now().Format(logTimeLayout), Operation: operation}
	var err error
	if event.OldData, err = object(before); err != nil {
		return fmt.Errorf("cdc %s: %w", topic, err)
	}
	if event.NewData, err = object(after); err != nil {
		return fmt.Errorf("cdc %s: %w", topic, err)
	}
	event.ChangeData = changed(event.OldData, event.NewData)
	if operation == Update && len(event.ChangeData) == 0 {
		return nil // nothing the consumers see has changed
	}

	value, err := json.Marshal(event)
	if err != nil {
		return fmt.Errorf("cdc %s: encode: %w", topic, err)
	}
	msg := kafkago.Message{Topic: topic, Key: []byte(strconv.FormatInt(id, 10)), Value: value}
	if err := w.WriteMessages(ctx, msg); err != nil {
		return fmt.Errorf("cdc %s: publish %d: %w", topic, id, err)
	}
	return nil
}

// object turns v into a JSON object; nil stays nil.
func object(v any) (map[string]any, error) {
	if v == nil {
		return nil, nil
	}
	raw, err := json.Marshal(v)
	if err != nil {
		return nil, err
	}
	var m map[string]any
	if err := json.Unmarshal(raw, &m); err != nil {
		return nil, fmt.Errorf("data must encode to a JSON object: %w", err)
	}
	return m, nil
}

// changed lists the keys whose values differ, sorted.
func changed(before, after map[string]any) []string {
	keys := []string{}
	for key, value := range after {
		old, ok := before[key]
		if !ok || !equal(old, value) {
			keys = append(keys, key)
		}
	}
	for key := range before {
		if _, ok := after[key]; !ok {
			keys = append(keys, key)
		}
	}
	slices.Sort(keys)
	return keys
}

func equal(a, b any) bool {
	x, _ := json.Marshal(a)
	y, _ := json.Marshal(b)
	return string(x) == string(y)
}
