package worker

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"log/slog"

	kafkago "github.com/segmentio/kafka-go"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/kafka"
)

const (
	{{.Type}}Topic = "{{.Topic}}"
	{{.Type}}Group = "{{.Group}}"
)

// {{.Type}}Message is the JSON value of a message on {{.Topic}}.
type {{.Type}}Message struct{}

// {{.Type}} consumes {{.Topic}} in group {{.Group}}. Add what handle needs
// (services, repositories) as fields and pass them to New{{.Type}}.
type {{.Type}} struct {
	reader *kafkago.Reader
	logger *slog.Logger
}

// New{{.Type}} joins the consumer group right away; build it only to Run it.
func New{{.Type}}(cfg config.Kafka, logger *slog.Logger) *{{.Type}} {
	return &{{.Type}}{
		reader: kafka.NewReader(cfg, {{.Type}}Topic, {{.Type}}Group),
		logger: logger.With("worker", "{{.Name}}"),
	}
}

// Run handles messages until ctx is done. A message is committed after it
// is handled; one that fails is logged and committed too, so a bad message
// cannot block the partition. Change that here if you need retries or a
// dead-letter topic.
func (w *{{.Type}}) Run(ctx context.Context) error {
	defer w.reader.Close()
	for {
		msg, err := w.reader.FetchMessage(ctx)
		if err != nil {
			if ctx.Err() != nil {
				return nil
			}
			return fmt.Errorf("worker {{.Name}}: fetch: %w", err)
		}
		if err := w.handle(ctx, msg); err != nil {
			w.logger.Error("message failed", "partition", msg.Partition, "offset", msg.Offset, "error", err.Error())
		}
		if err := w.reader.CommitMessages(ctx, msg); err != nil {
			if ctx.Err() != nil {
				return nil
			}
			return fmt.Errorf("worker {{.Name}}: commit: %w", err)
		}
	}
}

func (w *{{.Type}}) handle(ctx context.Context, msg kafkago.Message) error {
	var value {{.Type}}Message
	if err := json.Unmarshal(msg.Value, &value); err != nil {
		return fmt.Errorf("decode: %w", err)
	}
	return errors.New("not implemented")
}
