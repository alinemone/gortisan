package {{.Pkg}}

import (
	"context"

	"{{.Module}}/internal/platform/database/orm"
)

// Repository reads and writes {{.Table}}. It implements Store on
// orm.Repository (bun underneath) and returns this package's errors, so
// nothing above it depends on the orm.
type Repository struct {
	rows *orm.Repository[{{.Type}}]
}

// NewRepository runs its queries on db: the *bun.DB, or a transaction.
func NewRepository(db orm.IDB) *Repository {
	return &Repository{rows: orm.NewRepository[{{.Type}}](db)}
}

// WithTx returns a copy that runs its queries in tx (see orm.InTx).
func (r *Repository) WithTx(tx orm.IDB) *Repository {
	return &Repository{rows: r.rows.WithTx(tx)}
}

// Find returns ErrNotFound when there is no such row.
func (r *Repository) Find(ctx context.Context, id int64) (*{{.Type}}, error) {
	m, err := r.rows.Find(ctx, id)
	return m, orm.MapNotFound(err, ErrNotFound)
}

// List returns a page of rows, newest first.
func (r *Repository) List(ctx context.Context, limit, offset int) ([]*{{.Type}}, error) {
	return r.rows.Get(ctx, orm.OrderBy("?TableAlias.id DESC"), orm.Limit(limit), orm.Offset(offset))
}

// Create inserts m and fills its id and timestamps.
func (r *Repository) Create(ctx context.Context, m *{{.Type}}) error {
	return r.rows.Create(ctx, m)
}

// Update writes m (only columns, when given) and reads the stored row back
// into it, or returns ErrNotFound.
func (r *Repository) Update(ctx context.Context, m *{{.Type}}, columns ...string) error {
	return orm.MapNotFound(r.rows.Update(ctx, m, columns...), ErrNotFound)
}

{{if .SoftDelete}}// Delete sets deleted_at; the row is then skipped by every query above.{{else}}// Delete removes the row.{{end}}
func (r *Repository) Delete(ctx context.Context, id int64) error {
	return orm.MapNotFound(r.rows.Delete(ctx, id), ErrNotFound)
}

