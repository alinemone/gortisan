package repository

import (
	"context"

	"{{.Module}}/internal/database"
	"{{.Module}}/internal/database/orm"
	"{{.Module}}/internal/model"
)

// {{.Var}}Table (the column mapping) is generated from model.{{.Type}} into
// {{.Name}}_table_gen.go.

// {{.Type}}Repository reads and writes {{.Table}}.
type {{.Type}}Repository struct {
	db database.DBTX
}

func New{{.Type}}Repository(db database.DBTX) *{{.Type}}Repository {
	return &{{.Type}}Repository{db: db}
}

// WithTx returns a copy that runs its queries in tx.
func (r *{{.Type}}Repository) WithTx(tx database.DBTX) *{{.Type}}Repository {
	return &{{.Type}}Repository{db: tx}
}

// FindByID returns orm.ErrNotFound when there is no such row.
func (r *{{.Type}}Repository) FindByID(ctx context.Context, id int64) (*model.{{.Type}}, error) {
	return {{.Var}}Table.Find(ctx, r.db, id)
}

func (r *{{.Type}}Repository) List(ctx context.Context, limit, offset int) ([]*model.{{.Type}}, error) {
	return {{.Var}}Table.Get(ctx, r.db, orm.All().OrderBy("id DESC").Limit(limit).Offset(offset))
}

// Create inserts m and fills its id and timestamps.
func (r *{{.Type}}Repository) Create(ctx context.Context, m *model.{{.Type}}) error {
	return {{.Var}}Table.Create(ctx, r.db, m)
}

// Update writes set, e.g. orm.Set{"status": "paid"}, and returns the stored row.
func (r *{{.Type}}Repository) Update(ctx context.Context, id int64, set orm.Set) (*model.{{.Type}}, error) {
	return {{.Var}}Table.Update(ctx, r.db, id, set)
}

{{if .SoftDelete}}// Delete sets deleted_at; the row is then skipped by every query above.{{else}}// Delete removes the row.{{end}}
func (r *{{.Type}}Repository) Delete(ctx context.Context, id int64) error {
	return {{.Var}}Table.Delete(ctx, r.db, id)
}

