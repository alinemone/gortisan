package {{.Pkg}}

import (
	"context"

	kafkago "github.com/segmentio/kafka-go"

	"{{.Module}}/internal/cdc"
)

const CDCTopic = "{{.Topic}}"

// CDCData is what consumers see of a {{.Type}}. List only the fields they
// need; a change to any other field publishes nothing.
type CDCData struct {
	ID int64 `json:"id"`
}

func newCDCData(m *{{.Type}}) CDCData {
	return CDCData{
		ID: m.ID,
	}
}

// CDC publishes changes of {{.Type}} to {{.Topic}}. Call it after the
// transaction commits.
type CDC struct {
	writer *kafkago.Writer
}

func NewCDC(writer *kafkago.Writer) *CDC {
	return &CDC{writer: writer}
}

func (c *CDC) Created(ctx context.Context, m *{{.Type}}) error {
	return cdc.Publish(ctx, c.writer, CDCTopic, m.ID, cdc.Insert, nil, newCDCData(m))
}

// Updated publishes nothing when no field of CDCData changed.
func (c *CDC) Updated(ctx context.Context, before, after *{{.Type}}) error {
	return cdc.Publish(ctx, c.writer, CDCTopic, after.ID, cdc.Update, newCDCData(before), newCDCData(after))
}

func (c *CDC) Deleted(ctx context.Context, m *{{.Type}}) error {
	return cdc.Publish(ctx, c.writer, CDCTopic, m.ID, cdc.Delete, newCDCData(m), nil)
}
