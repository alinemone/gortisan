// Config is where and how to reach the service. Read it in
// internal/config, e.g. from {{.EnvPrefix}}_BASE_URL and {{.EnvPrefix}}_TOKEN.
type Config struct {
	BaseURL string
	Token   string // sent as "Authorization: Bearer <token>" when set
	Timeout time.Duration
}

// Client calls the service. It is safe for concurrent use.
type Client struct {
	baseURL string
	token   string
	http    *http.Client
}

func New(cfg Config) *Client {
	timeout := cfg.Timeout
	if timeout == 0 {
		timeout = 5 * time.Second
	}
	return &Client{
		baseURL: strings.TrimRight(cfg.BaseURL, "/"),
		token:   cfg.Token,
		http:    &http.Client{Timeout: timeout},
	}
}

