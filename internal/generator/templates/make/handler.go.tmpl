package {{.Pkg}}
{{- if .HasService}}

import "{{.DomainImport}}"
{{- end}}

// Handler serves the {{.Version}} {{.Words}} endpoints, registered in
// internal/api/{{.Version}}/routes.go. Inputs are in request.go, outputs in
// response.go; the rules are in the {{.DomainPkg}} domain.
type Handler struct {
{{- if .HasService}}
	service *{{.DomainPkg}}.Service
{{- end}}
}

func NewHandler({{if .HasService}}service *{{.DomainPkg}}.Service{{end}}) *Handler {
	return &Handler{ {{- if .HasService}}service: service{{end -}} }
}
