package {{.Pkg}}

import (
{{- if .JSON}}
	"encoding/json"
{{- end}}
	"time"

	"github.com/uptrace/bun"
)

// {{.Type}} is a row of {{.Table}}. Every field with a bun tag is a column;
// to add one, add a field — e.g. Name string `bun:"name" json:"name"` — and
// the column to the {{.Table}} table.
//
// Relations are fields too, loaded with orm.With in the repository, e.g.
//
//	Items []*Item `bun:"rel:has-many,join:id={{.Name}}_id" json:"items,omitempty"`
//
// bun tag options: pk and autoincrement for the primary key; nullzero writes
// a zero value as NULL (so the database default applies); soft_delete makes
// Delete set the column instead of removing the row.
type {{.Type}} struct {
	bun.BaseModel `bun:"table:{{.Table}}"`

	ID        int64      `bun:"id,pk,autoincrement" json:"id"`
{{- range .Fields}}
	{{.GoName}} {{.GoType}} `bun:"{{.Tag}}" json:"{{.Column}}"`
{{- end}}
	CreatedAt time.Time  `bun:"created_at,nullzero,notnull,default:current_timestamp" json:"created_at"`
	UpdatedAt time.Time  `bun:"updated_at,nullzero,notnull,default:current_timestamp" json:"updated_at"`
{{- if .SoftDelete}}
	DeletedAt *time.Time `bun:"deleted_at,soft_delete,nullzero" json:"deleted_at,omitempty"`
{{- end}}
}
