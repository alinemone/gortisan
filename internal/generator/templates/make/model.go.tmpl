package {{.Pkg}}

import (
{{- if .JSON}}
	"encoding/json"
{{- end}}
	"time"
)

// {{.Type}} is a row of {{.Table}}. Every field with a db tag is a column, and
// the mapping in repository.go is generated from them (by gortisan run on
// save, or ./gortisan generate). To add a column, add a field — e.g.
// Name string `db:"name" json:"name"` — and a migration.
// db tag options: pk for the primary key, default for a column the database
// fills (read back, never inserted).
//
//gortisan:table {{.Table}}
type {{.Type}} struct {
	ID        int64      `db:"id,pk" json:"id"`
{{- range .Fields}}
	{{.GoName}} {{.GoType}} `db:"{{.Column}}" json:"{{.Column}}"`
{{- end}}
	CreatedAt time.Time  `db:"created_at,default" json:"created_at"`
	UpdatedAt time.Time  `db:"updated_at,default" json:"updated_at"`
{{- if .SoftDelete}}
	DeletedAt *time.Time `db:"deleted_at,default" json:"deleted_at,omitempty"`
{{- end}}
}
