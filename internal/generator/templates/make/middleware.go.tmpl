package middleware

import (
	"github.com/labstack/echo/v5"
)

// {{.Func}} is an echo middleware. Give it what it needs as arguments and
// register it in internal/app/serve.go or a feature's routes.go:
//
//	e.Use(middleware.{{.Func}}())          // every route
//	g.Use(middleware.{{.Func}}())         // a group
//	g.GET("/x", h.X, middleware.{{.Func}}()) // one route
func {{.Func}}() echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c *echo.Context) error {
			// Before the handler. Return an error to stop here, e.g.
			// return echo.NewHTTPError(http.StatusForbidden, "...")
			err := next(c)
			// After the handler.
			return err
		}
	}
}
