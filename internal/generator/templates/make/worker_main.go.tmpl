// Command worker runs one Kafka worker: go run ./cmd/worker <name>.
//
// Each worker is a case below; `gortisan make:worker` prints the case to add.
// Run one process per worker, so each scales and restarts on its own.
package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/{{.Pkg}}"
)

const usage = "usage: worker <name>; workers: {{.Pkg}}.{{.Name}}"

func main() {
	if err := run(); err != nil {
		slog.Error("worker stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	if len(os.Args) != 2 {
		return errors.New(usage)
	}
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil))
	slog.SetDefault(logger)

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	// Build only the worker that runs: a Kafka reader joins its group when created.
	switch name := os.Args[1]; name {
	case "{{.Pkg}}.{{.Name}}":
		return {{.Pkg}}.New{{.Type}}Worker(cfg.Kafka, logger).Run(ctx)
	default:
		return fmt.Errorf("unknown worker %q; %s", name, usage)
	}
}
