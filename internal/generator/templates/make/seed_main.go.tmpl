// Command seed runs the seeders of internal/seed, in the order listed below,
// in one transaction:
//
//	go run ./cmd/seed              every seeder
//	go run ./cmd/seed {{.Name}}         only that one
//
// ./gortisan db:seed runs this command. Add a seeder with
// `gortisan make:seeder <name>` and list it here.
package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"github.com/jackc/pgx/v5"

	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database"
	"{{.Module}}/internal/seed"
)

// seeders run in this order.
var seeders = []struct {
	name string
	run  func(context.Context, database.DBTX) error
}{
	{"{{.Name}}", seed.{{.Type}}},
}

func main() {
	if err := run(os.Args[1:]); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		os.Exit(1)
	}
}

func run(args []string) error {
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	db, err := database.Open(ctx, cfg.Postgres)
	if err != nil {
		return err
	}
	defer db.Close()

	return database.InTx(ctx, db, func(tx pgx.Tx) error {
		ran := 0
		for _, s := range seeders {
			if len(args) > 0 && args[0] != s.name {
				continue
			}
			if err := s.run(ctx, tx); err != nil {
				return fmt.Errorf("%s: %w", s.name, err)
			}
			fmt.Println("seeded", s.name)
			ran++
		}
		if ran == 0 {
			return fmt.Errorf("no seeder named %q", args[0])
		}
		return nil
	})
}
