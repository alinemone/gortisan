package validator

import (
	"context"
	"errors"
)

// {{.Type}} is a validation rule: it implements validate.Rule. Give it the
// values and dependencies it checks, then use it in a request's Validate:
//
//	if err := errs.Check(ctx, "field", validator.New{{.Type}}(...)); err != nil {
//		return err
//	}
type {{.Type}} struct {
	message string
}

func New{{.Type}}() *{{.Type}} {
	return &{{.Type}}{message: "{{.Message}}"}
}

// Passes reports whether the value is valid. Return an error only when the
// check cannot run (a database or network failure).
func (v *{{.Type}}) Passes(ctx context.Context) (bool, error) {
	return false, errors.New("validator {{.Type}}: Passes is not implemented")
}

func (v *{{.Type}}) Message() string {
	return v.message
}
