.PHONY: run build test vet tidy{{if .Swagger}} swag{{end}}{{if .Migrations}} migrate{{end}}

run:
	go run . serve

build:
	go build -o bin/{{.Name}} .

test:
	go test ./...

vet:
	go vet ./...

tidy:
	go mod tidy
{{- if .Swagger}}

# Regenerates docs/ from the swag comments on main.go and the handlers.
swag:
	go run github.com/swaggo/swag/cmd/swag@{{.SwagVersion}} init
{{- end}}
{{- if .Migrations}}

migrate:
	go run . migrate up
{{- end}}
