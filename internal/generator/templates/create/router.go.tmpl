// Package router lists every endpoint of the service in one place.
package router

import (
	"github.com/labstack/echo/v4"

	"{{.Module}}/internal/handler"
)

// Handlers are the handlers the routes call. main.go builds them.
type Handlers struct {
	Health *handler.HealthHandler
{{- if .Metrics}}
	Metrics echo.HandlerFunc
{{- end}}
}

// Register adds every route to e.
func Register(e *echo.Echo, h Handlers) {
	e.GET("/ping", h.Health.Ping)
	e.GET("/health", h.Health.Check)
{{- if .Metrics}}
	e.GET("/metrics", h.Metrics)
{{- end}}

	v1 := e.Group("/v1")
	_ = v1 // e.g. v1.GET("/orders/:id", h.Order.GetOrder)
}
