// Package migrate applies the SQL files in migrations/ to the database and
// remembers which ran, in schema_migrations.
//
// A migration is a pair of files, <version>_<name>.up.sql and .down.sql,
// where version sorts by time (gortisan make:migration writes them). Each run
// of Up applies every pending migration as one batch; Rollback undoes whole
// batches, newest first. Each migration runs in its own transaction, unless
// its file contains the line "-- migrate:no-transaction" (needed for
// statements such as CREATE INDEX CONCURRENTLY).
//
// A Postgres advisory lock lets only one process migrate at a time, so
// several replicas starting together cannot apply a migration twice.
package migrate

import (
	"context"
	"database/sql"
	"fmt"
	"io/fs"
	"slices"
	"strings"
	"time"
)

// lockID is the advisory lock taken while migrating (any constant works; it
// only has to be the same for every process of this service).
const lockID = 7_420_133_701

const noTransaction = "-- migrate:no-transaction"

// Migration is one pair of files.
type Migration struct {
	Version string // 20261119081943
	Name    string // create_users_table
	Up      string
	Down    string
}

// Status is a migration and whether it ran.
type Status struct {
	Migration
	Applied   bool
	Batch     int
	AppliedAt time.Time
}

// Load reads the migrations of fsys, sorted by version.
func Load(fsys fs.FS) ([]Migration, error) {
	entries, err := fs.ReadDir(fsys, ".")
	if err != nil {
		return nil, err
	}
	byVersion := map[string]*Migration{}
	for _, entry := range entries {
		file := entry.Name()
		base, direction, ok := cutSuffixes(file, ".up.sql", ".down.sql")
		if !ok {
			continue
		}
		version, name, ok := strings.Cut(base, "_")
		if !ok || version == "" {
			return nil, fmt.Errorf("migrate: %s: name it <version>_<name>%s", file, direction)
		}
		content, err := fs.ReadFile(fsys, file)
		if err != nil {
			return nil, err
		}
		m := byVersion[version]
		if m == nil {
			m = &Migration{Version: version, Name: name}
			byVersion[version] = m
		} else if m.Name != name {
			return nil, fmt.Errorf("migrate: version %s is used by %s and %s", version, m.Name, name)
		}
		if direction == ".up.sql" {
			m.Up = string(content)
		} else {
			m.Down = string(content)
		}
	}
	migrations := make([]Migration, 0, len(byVersion))
	for _, m := range byVersion {
		if strings.TrimSpace(m.Up) == "" {
			return nil, fmt.Errorf("migrate: %s_%s has no .up.sql", m.Version, m.Name)
		}
		migrations = append(migrations, *m)
	}
	slices.SortFunc(migrations, func(a, b Migration) int { return strings.Compare(a.Version, b.Version) })
	return migrations, nil
}

func cutSuffixes(s string, suffixes ...string) (string, string, bool) {
	for _, suffix := range suffixes {
		if base, ok := strings.CutSuffix(s, suffix); ok {
			return base, suffix, true
		}
	}
	return "", "", false
}

// Migrator applies migrations to one database.
type Migrator struct {
	db         *sql.DB
	migrations []Migration
}

// New loads the migrations of fsys for db, e.g. the *sql.DB of the bun DB
// (db.DB).
func New(db *sql.DB, fsys fs.FS) (*Migrator, error) {
	migrations, err := Load(fsys)
	if err != nil {
		return nil, err
	}
	return &Migrator{db: db, migrations: migrations}, nil
}

// Up applies every pending migration as one new batch and returns them.
func (m *Migrator) Up(ctx context.Context) ([]Migration, error) {
	var done []Migration
	err := m.locked(ctx, func(conn *sql.Conn) error {
		applied, batch, err := m.applied(ctx, conn)
		if err != nil {
			return err
		}
		batch++
		for _, mig := range m.migrations {
			if _, ok := applied[mig.Version]; ok {
				continue
			}
			record := func(db execer) error {
				_, err := db.ExecContext(ctx, `INSERT INTO schema_migrations (version, name, batch) VALUES ($1, $2, $3)`, mig.Version, mig.Name, batch)
				return err
			}
			if err := run(ctx, conn, mig.Up, record); err != nil {
				return fmt.Errorf("migrate up %s_%s: %w", mig.Version, mig.Name, err)
			}
			done = append(done, mig)
		}
		return nil
	})
	return done, err
}

// Rollback undoes the last steps batches, newest migration first, and
// returns what it undid.
func (m *Migrator) Rollback(ctx context.Context, steps int) ([]Migration, error) {
	if steps < 1 {
		steps = 1
	}
	var done []Migration
	err := m.locked(ctx, func(conn *sql.Conn) error {
		applied, last, err := m.applied(ctx, conn)
		if err != nil {
			return err
		}
		for i := len(m.migrations) - 1; i >= 0; i-- {
			mig := m.migrations[i]
			st, ok := applied[mig.Version]
			if !ok || st.Batch <= last-steps {
				continue
			}
			if strings.TrimSpace(mig.Down) == "" {
				return fmt.Errorf("migrate: %s_%s has no .down.sql to roll back", mig.Version, mig.Name)
			}
			forget := func(db execer) error {
				_, err := db.ExecContext(ctx, `DELETE FROM schema_migrations WHERE version = $1`, mig.Version)
				return err
			}
			if err := run(ctx, conn, mig.Down, forget); err != nil {
				return fmt.Errorf("migrate down %s_%s: %w", mig.Version, mig.Name, err)
			}
			done = append(done, mig)
		}
		return nil
	})
	return done, err
}

// Status lists every migration and whether it ran.
func (m *Migrator) Status(ctx context.Context) ([]Status, error) {
	conn, err := m.db.Conn(ctx)
	if err != nil {
		return nil, err
	}
	defer conn.Close()
	applied, _, err := m.applied(ctx, conn)
	if err != nil {
		return nil, err
	}
	statuses := make([]Status, 0, len(m.migrations))
	for _, mig := range m.migrations {
		st := applied[mig.Version]
		st.Migration = mig
		statuses = append(statuses, st)
	}
	return statuses, nil
}

// Fresh drops every table of the current schema and applies all migrations.
// It destroys all data; use it only on a development database.
func (m *Migrator) Fresh(ctx context.Context) ([]Migration, error) {
	err := m.locked(ctx, func(conn *sql.Conn) error {
		rows, err := conn.QueryContext(ctx, `SELECT quote_ident(tablename) FROM pg_tables WHERE schemaname = current_schema()`)
		if err != nil {
			return err
		}
		var tables []string
		for rows.Next() {
			var table string
			if err := rows.Scan(&table); err != nil {
				rows.Close()
				return err
			}
			tables = append(tables, table)
		}
		rows.Close()
		if err := rows.Err(); err != nil {
			return err
		}
		for _, table := range tables {
			if _, err := conn.ExecContext(ctx, "DROP TABLE IF EXISTS "+table+" CASCADE"); err != nil {
				return fmt.Errorf("migrate fresh: drop %s: %w", table, err)
			}
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return m.Up(ctx)
}

type execer interface {
	ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error)
}

// run executes query and then bookkeep, both in one transaction unless the
// migration opts out.
func run(ctx context.Context, conn *sql.Conn, query string, bookkeep func(execer) error) error {
	if strings.Contains(query, noTransaction) {
		if _, err := conn.ExecContext(ctx, query); err != nil {
			return err
		}
		return bookkeep(conn)
	}
	tx, err := conn.BeginTx(ctx, nil)
	if err != nil {
		return err
	}
	defer func() { _ = tx.Rollback() }()
	if _, err := tx.ExecContext(ctx, query); err != nil {
		return err
	}
	if err := bookkeep(tx); err != nil {
		return err
	}
	return tx.Commit()
}

// locked runs fn on one connection that holds the advisory lock, after
// making sure schema_migrations exists.
func (m *Migrator) locked(ctx context.Context, fn func(conn *sql.Conn) error) error {
	conn, err := m.db.Conn(ctx)
	if err != nil {
		return err
	}
	defer conn.Close()
	if _, err := conn.ExecContext(ctx, `SELECT pg_advisory_lock($1)`, lockID); err != nil {
		return fmt.Errorf("migrate: lock: %w", err)
	}
	defer func() { _, _ = conn.ExecContext(context.WithoutCancel(ctx), `SELECT pg_advisory_unlock($1)`, lockID) }()

	if _, err := conn.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS schema_migrations (
		version    TEXT PRIMARY KEY,
		name       TEXT NOT NULL,
		batch      INTEGER NOT NULL,
		applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
	)`); err != nil {
		return fmt.Errorf("migrate: create schema_migrations: %w", err)
	}
	return fn(conn)
}

// applied returns the recorded migrations by version and the last batch.
func (m *Migrator) applied(ctx context.Context, conn *sql.Conn) (map[string]Status, int, error) {
	applied := map[string]Status{}
	var exists bool
	if err := conn.QueryRowContext(ctx, `SELECT to_regclass('schema_migrations') IS NOT NULL`).Scan(&exists); err != nil {
		return nil, 0, err
	}
	if !exists {
		return applied, 0, nil // never migrated: no table yet
	}
	rows, err := conn.QueryContext(ctx, `SELECT version, batch, applied_at FROM schema_migrations`)
	if err != nil {
		return nil, 0, err
	}
	defer rows.Close()
	last := 0
	for rows.Next() {
		var st Status
		if err := rows.Scan(&st.Version, &st.Batch, &st.AppliedAt); err != nil {
			return nil, 0, err
		}
		st.Applied = true
		applied[st.Version] = st
		last = max(last, st.Batch)
	}
	return applied, last, rows.Err()
}
