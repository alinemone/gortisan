// Command migrate applies the SQL migrations in internal/platform/database/migrations/ (embedded in the
// binary) to the database in .env / the environment:
//
//	go run ./cmd/migrate            apply pending migrations (also: up)
//	go run ./cmd/migrate rollback   undo the last batch (rollback 3: three batches)
//	go run ./cmd/migrate status     list migrations and whether they ran
//	go run ./cmd/migrate fresh --force   drop every table and migrate again (development only)
//
// ./gortisan migrate, migrate:rollback, migrate:status and migrate:fresh run
// this command. In production, run the built binary before the new version
// starts serving.
package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"os/signal"
	"strconv"
	"syscall"

	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database"
	"{{.Module}}/internal/platform/database/migrate"
	"{{.Module}}/internal/platform/database/migrations"
)

const usage = "usage: migrate [up | rollback [batches] | status | fresh --force]"

func main() {
	if err := run(os.Args[1:]); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		os.Exit(1)
	}
}

func run(args []string) error {
	command := "up"
	if len(args) > 0 {
		command, args = args[0], args[1:]
	}

	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	db, err := database.Open(ctx, cfg.Postgres)
	if err != nil {
		return err
	}
	defer db.Close()

	m, err := migrate.New(db.DB, migrations.FS)
	if err != nil {
		return err
	}

	switch command {
	case "up":
		done, err := m.Up(ctx)
		report("migrated", done)
		return err
	case "rollback":
		steps := 1
		if len(args) > 0 {
			if steps, err = strconv.Atoi(args[0]); err != nil || steps < 1 {
				return errors.New(usage)
			}
		}
		done, err := m.Rollback(ctx, steps)
		report("rolled back", done)
		return err
	case "status":
		statuses, err := m.Status(ctx)
		if err != nil {
			return err
		}
		for _, st := range statuses {
			state := "pending"
			if st.Applied {
				state = fmt.Sprintf("ran (batch %d, %s)", st.Batch, st.AppliedAt.Format("2006-01-02 15:04"))
			}
			fmt.Printf("%-8s %s_%s  %s\n", map[bool]string{true: "[x]", false: "[ ]"}[st.Applied], st.Version, st.Name, state)
		}
		return nil
	case "fresh":
		if len(args) == 0 || args[0] != "--force" {
			return errors.New("fresh drops every table; run it with --force, and never on production")
		}
		done, err := m.Fresh(ctx)
		report("migrated", done)
		return err
	default:
		return errors.New(usage)
	}
}

func report(verb string, done []migrate.Migration) {
	if len(done) == 0 {
		fmt.Println("nothing to do")
	}
	for _, mig := range done {
		fmt.Printf("%s %s_%s\n", verb, mig.Version, mig.Name)
	}
}
