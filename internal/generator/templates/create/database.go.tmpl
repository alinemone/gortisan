// Package database opens the PostgreSQL connection of the service: bun over
// pgx, built by the orm package from the settings in config.
//
// Repositories receive the *bun.DB (or a transaction, see orm.InTx) in their
// constructor; a transaction is passed explicitly, never through a context.
package database

import (
	"context"

	"github.com/uptrace/bun"

	"{{.Module}}/internal/platform/config"
	"{{.Module}}/internal/platform/database/orm"
)

// Open connects and pings the database. orm takes plain options, not the
// config package, so it stays free to move to a module of its own.
func Open(ctx context.Context, cfg config.Postgres) (*bun.DB, error) {
	return orm.Open(ctx, orm.Options{
		Host:            cfg.Host,
		Port:            int(cfg.Port),
		Database:        cfg.Database,
		User:            cfg.User,
		Password:        cfg.Password,
		Schema:          cfg.Schema,
		SSLMode:         cfg.SSLMode,
		ApplicationName: "{{.Name}}",
		ConnectTimeout:  cfg.ConnectTimeout,
		MaxOpenConns:    cfg.MaxOpenConns,
		MaxIdleConns:    cfg.MaxIdleConns,
		ConnMaxLifetime: cfg.ConnMaxLifetime,
	})
}
