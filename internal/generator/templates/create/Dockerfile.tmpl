FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{.Name}} ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && adduser -D -H app
USER app
COPY --from=build /out/{{.Name}} /usr/local/bin/{{.Name}}
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/{{.Name}}"]
