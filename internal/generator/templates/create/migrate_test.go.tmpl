package migrate

import (
	"testing"
	"testing/fstest"
)

func TestLoad(t *testing.T) {
	fsys := fstest.MapFS{
		"20260102000000_add_name.up.sql":       {Data: []byte("ALTER TABLE users ADD name TEXT;")},
		"20260102000000_add_name.down.sql":     {Data: []byte("ALTER TABLE users DROP name;")},
		"20260101000000_create_users.up.sql":   {Data: []byte("CREATE TABLE users (id INT);")},
		"20260101000000_create_users.down.sql": {Data: []byte("DROP TABLE users;")},
		"migrations.go":                        {Data: []byte("package migrations")},
	}
	got, err := Load(fsys)
	if err != nil {
		t.Fatal(err)
	}
	if len(got) != 2 || got[0].Name != "create_users" || got[1].Version != "20260102000000" || got[1].Down == "" {
		t.Fatalf("Load = %+v", got)
	}

	if _, err := Load(fstest.MapFS{"1_x.down.sql": {Data: []byte("x")}}); err == nil {
		t.Error("a migration without .up.sql must be rejected")
	}
	if _, err := Load(fstest.MapFS{"1_a.up.sql": {Data: []byte("x")}, "1_b.up.sql": {Data: []byte("y")}}); err == nil {
		t.Error("two migrations with one version must be rejected")
	}
}
