// Package migrations holds the SQL migrations of the service. They are
// embedded in the binary, so cmd/migrate needs no files next to it in
// production. Add one with `gortisan make:migration <name>`, which writes
// <time>_<name>.up.sql and .down.sql here.
package migrations

import "embed"

// FS holds every file of this directory; cmd/migrate reads the .sql ones.
//
//go:embed *
var FS embed.FS
