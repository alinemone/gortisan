// Package internal holds the code of the service in four layers. This test
// fails when one layer depends on another the wrong way:
//
//	api, worker  ->  domain  ->  platform
//
//   - domain is the business: it never knows about HTTP or Kafka.
//   - platform is infrastructure: it never knows about the business.
//   - api and worker are entry points: they never import each other.
//   - an API version never imports another version (v2 must not break v1).
//
// It runs with `go test ./...` and needs nothing but the standard library.
package internal

import (
	"bufio"
	"go/parser"
	"go/token"
	"io/fs"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"testing"
)

// forbidden lists, for each layer, the layers it must not import.
var forbidden = map[string][]string{
	"platform": {"domain", "api", "worker"},
	"domain":   {"api", "worker"},
	"api":      {"worker"},
	"worker":   {"api"},
}

func TestLayers(t *testing.T) {
	module := modulePath(t)
	err := filepath.WalkDir(".", func(path string, d fs.DirEntry, err error) error {
		if err != nil || d.IsDir() || !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
			return err
		}
		file, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ImportsOnly)
		if err != nil {
			return err
		}
		from := filepath.ToSlash(path)
		for _, imp := range file.Imports {
			target, _ := strconv.Unquote(imp.Path.Value)
			rest, ok := strings.CutPrefix(target, module+"/internal/")
			if !ok {
				continue
			}
			if reason := violation(from, rest); reason != "" {
				t.Errorf("internal/%s imports %s: %s", from, target, reason)
			}
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
}

// violation explains why a file at from (relative to internal/) must not
// import the package at to (also relative to internal/), or returns "".
func violation(from, to string) string {
	fromLayer, toLayer := layer(from), layer(to)
	for _, banned := range forbidden[fromLayer] {
		if toLayer == banned {
			return fromLayer + " must not depend on " + toLayer
		}
	}
	if fromLayer == "api" && toLayer == "api" {
		if a, b := apiVersion(from), apiVersion(to); a != "" && b != "" && a != b {
			return "API " + a + " must not depend on API " + b
		}
	}
	return ""
}

func layer(path string) string {
	first, _, _ := strings.Cut(path, "/")
	return first
}

// apiVersion returns "v1" for "api/v1/users/handler.go".
func apiVersion(path string) string {
	parts := strings.Split(path, "/")
	if len(parts) > 1 && strings.HasPrefix(parts[1], "v") {
		if _, err := strconv.Atoi(parts[1][1:]); err == nil {
			return parts[1]
		}
	}
	return ""
}

func modulePath(t *testing.T) string {
	t.Helper()
	file, err := os.Open(filepath.Join("..", "go.mod"))
	if err != nil {
		t.Fatal(err)
	}
	defer file.Close()
	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		if rest, ok := strings.CutPrefix(strings.TrimSpace(scanner.Text()), "module "); ok {
			return strings.TrimSpace(rest)
		}
	}
	t.Fatal("go.mod has no module line")
	return ""
}

func TestViolation(t *testing.T) {
	cases := map[[2]string]bool{
		{"domain/user/service.go", "platform/database"}: false,
		{"api/v1/users/handler.go", "domain/user"}:     false,
		{"api/v2/users/handler.go", "api/v1/users"}:  true,
		{"api/v1/routes.go", "api/v1/users"}:           false,
		{"api/router.go", "api/v2"}:                      false,
		{"domain/user/service.go", "api/v1/users"}:     true,
		{"platform/cdc/cdc.go", "domain/user"}:           true,
		{"worker/userworker/worker.go", "api/v1"}:        true,
	}
	for c, want := range cases {
		if got := violation(c[0], c[1]) != ""; got != want {
			t.Errorf("violation(%q, %q) = %v, want %v", c[0], c[1], got, want)
		}
	}
}
