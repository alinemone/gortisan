package handler

import (
{{- if or .Postgres .Redis}}
	"context"
{{- end}}
	"net/http"
{{- if or .Postgres .Redis}}
	"time"
{{- end}}

{{- if .Postgres}}
	"github.com/jackc/pgx/v5/pgxpool"
{{- end}}
	"github.com/labstack/echo/v4"
{{- if .Redis}}
	"github.com/redis/go-redis/v9"
{{- end}}
)

// HealthHandler answers liveness and readiness probes.
type HealthHandler struct {
{{- if .Postgres}}
	db *pgxpool.Pool
{{- end}}
{{- if .Redis}}
	redis *redis.Client
{{- end}}
}

func NewHealthHandler({{if .Postgres}}db *pgxpool.Pool{{end}}{{if and .Postgres .Redis}}, {{end}}{{if .Redis}}redis *redis.Client{{end}}) *HealthHandler {
	return &HealthHandler{ {{- if .Postgres}}db: db{{end}}{{if and .Postgres .Redis}}, {{end}}{{if .Redis}}redis: redis{{end -}} }
}

// Ping answers {"ping":"pong"}: the process is up.
func (h *HealthHandler) Ping(c echo.Context) error {
	return c.JSON(http.StatusOK, map[string]string{"ping": "pong"})
}

// HealthResponse is the body of Check.
type HealthResponse struct {
	Status string            `json:"status"`
	Checks map[string]string `json:"checks"`
}

// Check answers 200 when every dependency responds, 503 otherwise.
func (h *HealthHandler) Check(c echo.Context) error {
{{- if or .Postgres .Redis}}
	ctx, cancel := context.WithTimeout(c.Request().Context(), 2*time.Second)
	defer cancel()
{{end}}
	response := HealthResponse{Status: "pass", Checks: map[string]string{}}
{{- if .Postgres}}
	response.Checks["postgres"] = "up"
	if err := h.db.Ping(ctx); err != nil {
		response.Status, response.Checks["postgres"] = "fail", "down"
	}
{{- end}}
{{- if .Redis}}
	response.Checks["redis"] = "up"
	if err := h.redis.Ping(ctx).Err(); err != nil {
		response.Status, response.Checks["redis"] = "fail", "down"
	}
{{- end}}

	status := http.StatusOK
	if response.Status != "pass" {
		status = http.StatusServiceUnavailable
	}
	return c.JSON(status, response)
}
