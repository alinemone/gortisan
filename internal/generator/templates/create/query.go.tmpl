package orm

import (
	"fmt"
	"strings"
)

// Query is the WHERE, ORDER BY, LIMIT and OFFSET of a select. It is a value:
// every method returns a new Query and leaves the receiver unchanged.
//
//	q := orm.Where("user_id = ?", userID).
//		Where("status IN (?, ?)", "paid", "sent").
//		OrderBy("id DESC").
//		Limit(20)
//
// Conditions use ? for arguments; they are numbered $1, $2, ... when the SQL
// is built and the values are sent separately, never written into the SQL.
// A ? inside a quoted string literal is left alone. Column names and ORDER BY
// expressions are written as given, so never build them from user input.
type Query struct {
	where       []condition
	orderBy     []string
	limit       int
	offset      int
	withTrashed bool
}

type condition struct {
	sql  string
	args []any
}

// All matches every row.
func All() Query {
	return Query{}
}

// Where starts a query with one condition.
func Where(sql string, args ...any) Query {
	return Query{}.Where(sql, args...)
}

// Where adds a condition; conditions are joined with AND.
func (q Query) Where(sql string, args ...any) Query {
	q.where = append(q.where[:len(q.where):len(q.where)], condition{sql: sql, args: args})
	return q
}

// OrderBy adds an ORDER BY expression, e.g. "created_at DESC".
func (q Query) OrderBy(expr string) Query {
	q.orderBy = append(q.orderBy[:len(q.orderBy):len(q.orderBy)], expr)
	return q
}

// Limit returns at most n rows; 0 means no limit.
func (q Query) Limit(n int) Query {
	q.limit = n
	return q
}

// Offset skips the first n rows.
func (q Query) Offset(n int) Query {
	q.offset = n
	return q
}

// WithTrashed includes soft-deleted rows.
func (q Query) WithTrashed() Query {
	q.withTrashed = true
	return q
}

func (q Query) tailSQL() string {
	var b strings.Builder
	if len(q.orderBy) > 0 {
		b.WriteString(" ORDER BY " + strings.Join(q.orderBy, ", "))
	}
	if q.limit > 0 {
		fmt.Fprintf(&b, " LIMIT %d", q.limit)
	}
	if q.offset > 0 {
		fmt.Fprintf(&b, " OFFSET %d", q.offset)
	}
	return b.String()
}

// rebind replaces each ? outside string literals with $first, $first+1, ...
// and checks that there are exactly want of them.
func rebind(sql string, first, want int) (string, error) {
	var b strings.Builder
	n := 0
	inString := false
	for i := 0; i < len(sql); i++ {
		ch := sql[i]
		switch {
		case ch == '\'':
			inString = !inString
			b.WriteByte(ch)
		case ch == '?' && !inString:
			fmt.Fprintf(&b, "$%d", first+n)
			n++
		default:
			b.WriteByte(ch)
		}
	}
	if n != want {
		return "", fmt.Errorf("condition %q has %d placeholders but %d arguments", sql, n, want)
	}
	return b.String(), nil
}
