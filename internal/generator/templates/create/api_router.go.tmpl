// Package api is the HTTP side of the service. It knows the routes and the
// shape of requests and responses; the rules live in internal/domain.
//
// Each API version is its own package (v1, v2, ...) with its own handlers,
// requests and responses. Versions share the domain services, never each
// other's code, so v1 keeps working while v2 changes.
package api

import (
	"github.com/labstack/echo/v4"

	v1 "{{.Module}}/internal/api/v1"
	"{{.Module}}/internal/platform/health"
)

// Routes is everything the routes need. main.go builds it.
type Routes struct {
	Health *health.Handler
{{- if .Metrics}}
	Metrics echo.HandlerFunc
{{- end}}
	V1 v1.Services
}

// Register adds every route to e: probes, then each API version under its
// prefix. A new version is a new package and one line here, e.g.
//
//	v2.Register(e.Group("/v2"), r.V2)
func Register(e *echo.Echo, r Routes) {
	e.GET("/ping", r.Health.Ping)
	e.GET("/health", r.Health.Check)
{{- if .Metrics}}
	e.GET("/metrics", r.Metrics)
{{- end}}

	v1.Register(e.Group("/v1"), r.V1)
}
