// Command api runs the {{.Title}} HTTP service.
//
// Every dependency is built here, in order, and handed to whoever needs it:
// config -> connections -> domain services -> api versions -> routes.
// Nothing is looked up from a context or a registry.
package main

import (
	"context"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"{{.Module}}/internal/api"
	v1 "{{.Module}}/internal/api/v1"
	"{{.Module}}/internal/platform/config"
{{- if .Redis}}
	"{{.Module}}/internal/platform/cache"
{{- end}}
{{- if .Postgres}}
	"{{.Module}}/internal/platform/database"
{{- end}}
	"{{.Module}}/internal/platform/health"

	"{{.Module}}/internal/platform/server"
)

func main() {
	if err := run(); err != nil {
		slog.Error("api stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}

	logger := newLogger(cfg.Debug)
	slog.SetDefault(logger)

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
{{if .Postgres}}
	db, err := database.Open(ctx, cfg.Postgres)
	if err != nil {
		return err
	}
	defer db.Close()
{{end}}
{{- if .Redis}}
	rdb, err := cache.Open(ctx, cfg.Redis)
	if err != nil {
		return err
	}
	defer rdb.Close()
{{end}}


	// Domain services are built here, from the bottom up, and given to the
	// api versions that use them, e.g.
	//
	//	users := user.NewService(user.NewRepository(db))
	//	... V1: v1.Services{User: users}
	routes := api.Routes{
		Health: health.NewHandler({{if .Postgres}}db{{end}}{{if and .Postgres .Redis}}, {{end}}{{if .Redis}}rdb{{end}}),

		V1: v1.Services{},
	}

	e := server.New(logger)
	api.Register(e, routes)

	logger.Info("listening", "addr", ":"+cfg.HTTP.Port)
	return server.Run(ctx, e, cfg.HTTP)
}

func newLogger(debug bool) *slog.Logger {
	level := slog.LevelInfo
	if debug {
		level = slog.LevelDebug
	}
	return slog.New(slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: level}))
}
