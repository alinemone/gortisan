package orm

import (
	"reflect"
	"testing"
)

type item struct{}

var items = Table[item]{
	Name:             "items",
	PrimaryKey:       "id",
	Columns:          []string{"id", "name", "status", "updated_at", "deleted_at"},
	UpdatedAtColumn:  "updated_at",
	SoftDeleteColumn: "deleted_at",
}

func TestSelectSQL(t *testing.T) {
	q := Where("status = ?", "paid").Where("name <> '?' AND id > ?", 10).OrderBy("id DESC").Limit(5).Offset(10)
	sql, args, err := items.selectSQL(items.ColumnList(), q)
	if err != nil {
		t.Fatal(err)
	}
	want := "SELECT id, name, status, updated_at, deleted_at FROM items WHERE (status = $1) AND (name <> '?' AND id > $2) AND deleted_at IS NULL ORDER BY id DESC LIMIT 5 OFFSET 10"
	if sql != want {
		t.Errorf("sql\n got: %s\nwant: %s", sql, want)
	}
	if !reflect.DeepEqual(args, []any{"paid", 10}) {
		t.Errorf("args = %v", args)
	}
}

func TestWithTrashed(t *testing.T) {
	sql, _, err := items.selectSQL("1", All().WithTrashed())
	if err != nil {
		t.Fatal(err)
	}
	if want := "SELECT 1 FROM items"; sql != want {
		t.Errorf("got %q, want %q", sql, want)
	}
}

func TestUpdateSQL(t *testing.T) {
	sql, args, err := items.updateSQL(Where("id = ?", 7), Set{"status": "sent", "name": "x"})
	if err != nil {
		t.Fatal(err)
	}
	want := "UPDATE items SET name = $1, status = $2, updated_at = now() WHERE (id = $3) AND deleted_at IS NULL"
	if sql != want {
		t.Errorf("sql\n got: %s\nwant: %s", sql, want)
	}
	if !reflect.DeepEqual(args, []any{"x", "sent", 7}) {
		t.Errorf("args = %v", args)
	}
}

func TestUpdateRejectsUnknownColumn(t *testing.T) {
	if _, _, err := items.updateSQL(All(), Set{"name; DROP TABLE items": 1}); err == nil {
		t.Fatal("want an error for a column that is not in Columns")
	}
}

func TestPlaceholderCountMismatch(t *testing.T) {
	if _, _, err := items.selectSQL("1", Where("a = ? AND b = ?", 1)); err == nil {
		t.Fatal("want an error when placeholders and arguments differ")
	}
}

func TestQueryIsAValue(t *testing.T) {
	base := Where("a = ?", 1)
	first := base.Where("b = ?", 2)
	second := base.Where("c = ?", 3)
	if len(base.where) != 1 || first.where[1].sql != "b = ?" || second.where[1].sql != "c = ?" {
		t.Fatal("deriving a query changed another one")
	}
}
