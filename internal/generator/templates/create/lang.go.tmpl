// Package lang holds the texts the service shows to people, embedded in the
// binary: fa.json maps a key such as "general:entity-not-found" to its text,
// with %s where trans.T puts its arguments. Keys are grouped by a prefix,
// "<group>:<name>"; internal/platform/trans fails its test when the code uses
// a key that is not in fa.json.
package lang

import "embed"

// Files are the language files.
//
//go:embed *.json
var Files embed.FS
